{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jrpg.dev/verifiers-v2/environment.schema.json",
  "title": "JRPG verifier v2 environment",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "template", "dag", "defaultProject", "policies"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "kind": { "const": "jrpg-game-design-verifier-environment" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "minLength": 1 },
    "dag": { "type": "string", "minLength": 1 },
    "defaultProject": { "type": "string", "minLength": 1 },
    "reportDirectory": { "type": "string", "minLength": 1 },
    "policies": {
      "type": "object",
      "required": ["failClosed", "requireTemplateAnchors", "requireDependencyProvenance", "maximumArtifactsPerNode", "allowedArtifactExtensions"],
      "properties": {
        "failClosed": { "type": "boolean" },
        "requireTemplateAnchors": { "type": "boolean" },
        "requireDependencyProvenance": { "type": "boolean" },
        "maximumArtifactsPerNode": { "type": "integer", "minimum": 1 },
        "allowedArtifactExtensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\." }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

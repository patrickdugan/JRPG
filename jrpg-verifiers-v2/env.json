{
  "$schema": "./schemas/environment.schema.json",
  "schemaVersion": 2,
  "kind": "jrpg-game-design-verifier-environment",
  "id": "jrpg-game-design-verifiers-v2",
  "title": "JRPG Game Design Verifiers v2",
  "template": "../JRPG Project Plan Template.md",
  "dag": "dag.json",
  "defaultProject": "projects/bells-black-chrysanthemum.json",
  "reportDirectory": "reports",
  "policies": {
    "failClosed": true,
    "requireTemplateAnchors": true,
    "requireDependencyProvenance": true,
    "maximumArtifactsPerNode": 24,
    "allowedArtifactExtensions": [
      ".md",
      ".json",
      ".mjs",
      ".js",
      ".html",
      ".css",
      ".png",
      ".svg",
      ".py",
      ".mp4",
      ".webm"
    ]
  }
}
